{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "title": {
  "text": "Who is being watched across Australia?",
  "subtitle": [
   "One map per animal or plant group. With all species shown, birds blanket the country while reptiles are tracked in only a few places.",
   "Use the buttons below to filter by threat level. Try Critically Endangered: only 7 dots are left on the mammal map."
  ],
  "anchor": "middle",
  "font": "Schibsted Grotesk, Helvetica Neue, Arial, sans-serif",
  "fontSize": 18,
  "subtitleFont": "Schibsted Grotesk, Helvetica Neue, Arial, sans-serif",
  "subtitleFontSize": 14,
  "fontWeight": 700,
  "subtitleColor": "#475b60",
  "offset": 14,
  "subtitlePadding": 6
 },
 "columns": 3,
 "concat": [
  {
   "title": {
    "text": "Birds",
    "anchor": "middle",
    "font": "Schibsted Grotesk, Helvetica Neue, Arial, sans-serif",
    "fontSize": 16,
    "subtitleFont": "Schibsted Grotesk, Helvetica Neue, Arial, sans-serif",
    "subtitleFontSize": 13,
    "offset": 22
   },
   "width": 261,
   "height": 223,
   "projection": {
    "type": "conicEqualArea",
    "parallels": [
     -18,
     -36
    ],
    "rotate": [
     -134,
     0
    ],
    "scale": 333.45,
    "translate": [
     134.64,
     -190.64
    ]
   },
   "layer": [
    {
     "data": {
      "url": "js/australia_states.topo.json",
      "format": {
       "type": "topojson",
       "feature": "data"
      }
     },
     "mark": {
      "type": "geoshape",
      "fill": "#d9e4e6",
      "stroke": "#ffffff",
      "strokeWidth": 0.8
     }
    },
    {
     "data": {
      "url": "data/tsx_points.csv",
      "format": {
       "type": "csv",
       "parse": {
        "lat": "number",
        "lon": "number",
        "offshore": "number"
       }
      }
     },
     "transform": [
      {
       "filter": "datum.group == 'Birds' && datum.offshore == 0 && (level == 'All threat levels' || datum.epbc_status == level) && isValid(datum.lat) && isValid(datum.lon)"
      },
      {
       "window": [
        {
         "op": "row_number",
         "as": "rn"
        }
       ],
       "groupby": [
        "lat",
        "lon"
       ],
       "sort": [
        {
         "field": "scientific_name"
        }
       ]
      },
      {
       "calculate": "datum.lon + 0.4 * sqrt(datum.rn - 1) * cos(datum.rn * 2.39996)",
       "as": "lon_j"
      },
      {
       "calculate": "datum.lat + 0.4 * sqrt(datum.rn - 1) * sin(datum.rn * 2.39996)",
       "as": "lat_j"
      }
     ],
     "mark": {
      "type": "circle",
      "size": 12,
      "color": "#c0397b",
      "opacity": 0.8,
      "stroke": "#ffffff",
      "strokeWidth": 0.3
     },
     "encoding": {
      "longitude": {
       "field": "lon_j",
       "type": "quantitative"
      },
      "latitude": {
       "field": "lat_j",
       "type": "quantitative"
      },
      "tooltip": [
       {
        "field": "common_name",
        "title": "Species"
       },
       {
        "field": "scientific_name",
        "title": "Scientific name"
       },
       {
        "field": "subregion",
        "title": "Region"
       },
       {
        "field": "epbc_status",
        "title": "Status"
       }
      ]
     }
    },
    {
     "data": {
      "url": "data/tsx_points.csv",
      "format": {
       "type": "csv",
       "parse": {
        "lat": "number",
        "lon": "number",
        "offshore": "number"
       }
      }
     },
     "transform": [
      {
       "filter": "datum.group == 'Birds' && datum.offshore == 0 && (level == 'All threat levels' || datum.epbc_status == level)"
      },
      {
       "calculate": "datum.lat + '_' + datum.lon",
       "as": "loc"
      },
      {
       "aggregate": [
        {
         "op": "distinct",
         "field": "scientific_name",
         "as": "sp"
        },
        {
         "op": "distinct",
         "field": "loc",
         "as": "regions"
        }
       ]
      },
      {
       "calculate": "format(datum.sp, ',') + (datum.sp == 1 ? ' species' : ' species') + ' in ' + format(datum.regions, ',') + (datum.regions == 1 ? ' region' : ' regions')",
       "as": "txt"
      }
     ],
     "mark": {
      "type": "text",
      "align": "center",
      "baseline": "top",
      "font": "Schibsted Grotesk, Helvetica Neue, Arial, sans-serif",
      "fontSize": 13,
      "color": "#475b60",
      "lineHeight": 16
     },
     "encoding": {
      "x": {
       "value": 130.5
      },
      "y": {
       "value": 0
      },
      "text": {
       "field": "txt"
      }
     }
    }
   ]
  },
